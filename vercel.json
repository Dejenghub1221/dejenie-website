{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "portfolio/**",
      "use": "@vercel/static"
    },
    {
      "src": "admin/dist/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.js"
    },
    {
      "src": "/uploads/(.*)",
      "dest": "api/index.js"
    },
    {
      "src": "/portfolio",
      "dest": "portfolio/index.html"
    },
    {
      "src": "/portfolio/(.*)",
      "dest": "portfolio/$1"
    },
    {
      "src": "/admin/assets/(.*)",
      "dest": "admin/dist/assets/$1"
    },
    {
      "src": "/admin/(.*\\.(?:js|css|svg|png|jpg|jpeg|ico|json|woff|woff2))",
      "dest": "admin/dist/$1"
    },
    {
      "src": "/admin.*",
      "dest": "admin/dist/index.html"
    },
    {
      "src": "/",
      "dest": "api/index.js"
    }
  ]
}
