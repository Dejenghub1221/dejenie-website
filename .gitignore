# ── Dependencies ─────────────────────────────────────────
node_modules/
api/node_modules/
admin/node_modules/

# ── Secrets — NEVER push ─────────────────────────────────
api/.env
.env

# ── OS files ─────────────────────────────────────────────
.DS_Store
Thumbs.db

